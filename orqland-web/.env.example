NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Map tiles for the live delivery maps (Leaflet). Greyscale-filtered to match the neutral design.
# Defaults to CARTO "light_all" (OpenStreetMap data) — check the provider's terms / use your own key in production.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
